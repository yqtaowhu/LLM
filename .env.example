# LLM API 配置
# 复制此文件为 .env 并填入你的实际配置

# ==================== Minimax API 配置 ====================
# Minimax API Key（从 https://api.minimax.chat/ 获取）
MINIMAX_API_KEY=your_api_key_here

# Minimax Group ID
MINIMAX_GROUP_ID=your_group_id_here

# Minimax API 基础 URL（通常不需要修改）
MINIMAX_BASE_URL=https://api.minimax.chat/v1


# ==================== Anthropic API 配置 ====================
# Anthropic API Key（从 https://console.anthropic.com/ 获取）
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic API 基础 URL
# 如果使用官方API，设置为: https://api.anthropic.com/v1
# 如果使用代理或自定义端点，设置为你的代理地址，例如:
ANTHROPIC_BASE_URL=https://xx.xx/api/anthropic
